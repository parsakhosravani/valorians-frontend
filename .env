# Defaults, committed. Put real values (especially TELEGRAM_BOT_TOKEN) in
# .env.local, which is git-ignored, or in your host's environment settings.

# ── Server only (never exposed to the browser) ──────────────────────────────
# Bot token from @BotFather. Used to verify players' Telegram sign-in and to
# check channel membership for the Telegram quest. REQUIRED in production.
TELEGRAM_BOT_TOKEN=
# Channel the Telegram quest checks, e.g. @valorians. The bot must be an admin
# there for the check to work; otherwise the quest falls back to a short timer.
TELEGRAM_CHANNEL_ID=
# Where the SQLite database lives. Must be on persistent storage.
DATABASE_PATH=./data/valorians.db
# How long (seconds) Telegram launch data stays valid.
TELEGRAM_AUTH_MAX_AGE=86400

# ── Client ──────────────────────────────────────────────────────────────────
# Bot username without @, e.g. ValoriansBot
NEXT_PUBLIC_BOT_ADDRESS=
# Mini App short name set in @BotFather (/newapp). Invite links look like
# https://t.me/<BOT_ADDRESS>/<APP_SHORT_NAME>?startapp=<code>
NEXT_PUBLIC_APP_SHORT_NAME=start
# Quest links: a handle (valorians / @valorians) or a full URL. Leave a quest's
# link empty to hide that quest.
NEXT_PUBLIC_TELEGRAM_CHANNEL=
NEXT_PUBLIC_YOUTUBE_CHANNEL=
NEXT_PUBLIC_TWITTER_CHANNEL=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Set to true to let the game run in a normal browser with a fake local player.
# NEVER enable in production: anyone could sign in as anyone.
NEXT_PUBLIC_DEV_LOGIN=
# Set to anything to show the game instead of the "play on mobile" QR page.
NEXT_PUBLIC_IGNORE_QR_CODE=
