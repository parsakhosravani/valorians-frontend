# Copy to mirror/.env.mirror (git-ignored) and fill in. build.ts bakes these
# into the mirror: server values into tgcloud/lib/valorians.js, NEXT_PUBLIC_*
# into the Mini App. The bot token is NOT needed: on Telegram Serverless the
# SDK is already signed in as the bot.

# The Mini App URL that `npx tgcloud push` prints, e.g. https://app123456.tgcloud.ai
# Used for the bot's "Open game" buttons.
APP_URL=
# The mirror bot's username without @, and the Mini App short name from @BotFather.
NEXT_PUBLIC_BOT_ADDRESS=
NEXT_PUBLIC_APP_SHORT_NAME=start
# Who may use /announce etc. in the mirror bot (Telegram user ids, comma-separated).
BOT_ADMIN_IDS=
# Optional: a private code so t.me/<bot>?start=admin_<code> makes you admin.
BOT_ADMIN_CODE=
# Release announcements after deploys: off (default for the mirror), draft or auto.
RELEASE_ANNOUNCE=off
# Same meaning as in the main .env
PLUS_PRICE_STARS=
TELEGRAM_CHANNEL_ID=
NEXT_PUBLIC_TELEGRAM_CHANNEL=
NEXT_PUBLIC_YOUTUBE_CHANNEL=
NEXT_PUBLIC_TWITTER_CHANNEL=
# Show the game outside phones too (the QR page otherwise).
NEXT_PUBLIC_IGNORE_QR_CODE=
